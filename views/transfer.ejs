<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="nav-brand"><a href="/">CSRF</a></div>
    <div class="nav-links">
      <span class="nav-user">Welcome, <%= user.displayName %></span>
      <a href="/dashboard">Dashboard</a>
      <a href="/profile">Profile</a>
      <a href="/settings">Settings</a>
      <a href="/security">Security</a>
      <a href="/transfer" class="active">Transfer</a>
      <% if (user.role === 'admin') { %>
        <a href="/admin" class="nav-admin">Admin</a>
      <% } %>
      <a href="/challenges" class="nav-challenges">Challenges</a>
      <a href="/targets">Targets</a>
      <a href="/logout" class="nav-logout">Logout</a>
    </div>
  </nav>
  <main class="container">
    <div class="page-header">
      <h1>Fund Transfer</h1>
      <p class="text-muted">Send money securely to any account</p>
    </div>
    <% if (success) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>
    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>
    <div class="settings-grid">
      <div class="card">
        <h3>Send Money</h3>
        <form id="transferForm" class="settings-form">
          <div class="form-group">
            <label for="toAccount">Recipient Account</label>
            <input type="text" id="toAccount" name="toAccount" placeholder="e.g., john_doe" required>
          </div>
          <div class="form-group">
            <label for="amount">Amount ($)</label>
            <input type="number" id="amount" name="amount" step="0.01" min="0.01" placeholder="0.00" required>
          </div>
          <div class="form-group">
            <label for="memo">Memo (optional)</label>
            <input type="text" id="memo" name="memo" placeholder="What's this for?">
          </div>
          <div class="balance-display">
            Available: $<%= user.balance.toLocaleString('en-US', {minimumFractionDigits: 2}) %>
          </div>
          <button type="submit" class="btn btn-primary">Send Money</button>
        </form>
        <div id="transferResult" class="hidden"></div>
      </div>
      <div class="card">
        <h3>Transfer History</h3>
        <% if (user.transfers.length === 0) { %>
          <p class="text-muted">No transfers yet</p>
        <% } else { %>
          <div class="transfer-list">
            <% user.transfers.slice().reverse().forEach(function(t) { %>
              <div class="transfer-item">
                <div class="transfer-info">
                  <span class="transfer-to">To: <%= t.to %></span>
                  <span class="transfer-date"><%= new Date(t.timestamp).toLocaleString() %></span>
                  <% if (t.memo) { %>
                    <span class="transfer-memo"><%= t.memo %></span>
                  <% } %>
                </div>
                <span class="transfer-amount">-$<%= t.amount.toFixed(2) %></span>
              </div>
            <% }); %>
          </div>
        <% } %>
      </div>
    </div>
  </main>
  <script>
  document.getElementById('transferForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const formData = new FormData(this);
    const resultDiv = document.getElementById('transferResult');
    try {
      const res = await fetch('/api/transfer', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          toAccount: formData.get('toAccount'),
          amount: parseFloat(formData.get('amount')),
          memo: formData.get('memo')
        })
      });
      const data = await res.json();
      resultDiv.className = data.success ? 'alert alert-success' : 'alert alert-error';
      resultDiv.textContent = data.success ? data.message : data.error;
      resultDiv.classList.remove('hidden');
      if (data.success) {
        setTimeout(() => location.reload(), 1500);
      }
    } catch(err) {
      resultDiv.className = 'alert alert-error';
      resultDiv.textContent = 'Transfer failed: ' + err.message;
      resultDiv.classList.remove('hidden');
    }
  });
  </script>
  <footer class="footer">
    <p>&copy; 2025 CSRF Bank. Educational Platform for Security Researchers.</p>
  </footer>
</body>
</html>
