<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="nav-brand"><a href="/">CSRF</a></div>
    <div class="nav-links">
      <span class="nav-user">Welcome, <%= user.displayName %></span>
      <a href="/dashboard">Dashboard</a>
      <a href="/profile" class="active">Profile</a>
      <a href="/settings">Settings</a>
      <a href="/security">Security</a>
      <a href="/transfer">Transfer</a>
      <% if (user.role === 'admin') { %>
        <a href="/admin" class="nav-admin">Admin</a>
      <% } %>
      <a href="/challenges" class="nav-challenges">Challenges</a>
      <a href="/targets">Targets</a>
      <a href="/logout" class="nav-logout">Logout</a>
    </div>
  </nav>
  <main class="container">
    <div class="page-header">
      <h1>Profile Settings</h1>
      <p class="text-muted">Manage your public profile information</p>
    </div>
    <% if (success) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>
    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>
    <div class="settings-grid">
      <div class="card">
        <h3>Change Display Name</h3>
        <p class="text-muted">Update how your name appears to other users</p>
        <!-- VULN LEVEL 1: No CSRF token at all -->
        <form method="POST" action="/profile/update-name" class="settings-form">
          <div class="form-group">
            <label for="displayName">Display Name</label>
            <input type="text" id="displayName" name="displayName" value="<%= user.displayName %>" required>
          </div>
          <button type="submit" class="btn btn-primary">Update Name</button>
        </form>
      </div>
      <div class="card">
        <h3>Current Profile</h3>
        <div class="profile-preview">
          <div class="profile-avatar"><%= user.displayName.charAt(0).toUpperCase() %></div>
          <div class="profile-info">
            <h4><%= user.displayName %></h4>
            <p><%= user.email %></p>
            <span class="badge badge-<%= user.role === 'admin' ? 'premium' : 'standard' %>"><%= user.role %></span>
          </div>
        </div>
      </div>
    </div>
  </main>
  <footer class="footer">
    <p>&copy; 2025 CSRF Bank. Educational Platform for Security Researchers.</p>
  </footer>
  <% if (typeof flag !== 'undefined' && flag) { %>
  <!-- FLAG: <%= flag %> -->
  <% } %>
</body>
</html>
